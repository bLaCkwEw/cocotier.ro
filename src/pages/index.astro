---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@lib/PostCard.astro";
import { getPublishedPosts } from "@lib/posts";

const all_posts = await getPublishedPosts();
const blog_posts = all_posts.slice(0, 3);
---

<BaseLayout
	title="Home"
	description="cocotier.ro is a personal website where I write about tech, life, and whatever else catches my interest."
>
	<main id="main-content">
		<h1 class="my-16 text-center text-3xl font-bold">Latest Posts</h1>
		<section>
			{
				blog_posts.map((post) => (
					<PostCard post={post} />
				))
			}
		</section>
	</main>
</BaseLayout>
