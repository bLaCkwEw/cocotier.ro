---
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@lib/PostCard.astro";
import { getPublishedPosts } from "@lib/posts";

const blog_posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="Archive of articles from my personal blog, covering tech, life, and whatever else I find interesting.">
	<main id="main-content">
		<h1 class="my-16 text-center text-3xl font-bold">Archive</h1>
		<section>
			{
				blog_posts.map((post) => (
					<PostCard post={post} />
				))
			}
		</section>
	</main>
</BaseLayout>
