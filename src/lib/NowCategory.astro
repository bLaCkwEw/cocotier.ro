---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import NowEntry from "./NowEntry.astro";

interface Props {
	title: string;
	icon: string;
	entries: CollectionEntry<"now">[];
}

const { title, icon, entries } = Astro.props;
const id = title.toLowerCase();
---

<div class="mt-8">
  <h2 class="flex gap-1 text-2xl font-bold" id={title.toLowerCase()}>
		<Icon name={icon} size={32} class="inline-block" />
    {title}
	</h2>
	<div class="mt-4 space-y-4">
		{entries.length > 0 && <NowEntry entry={entries[0]} />}
		{
			entries.length > 1 && (
				<details id={`older-${id}`}>
					<summary
						class="font-medium hover:text-accent cursor-pointer rounded focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
					>
						Older entries
					</summary>
					<div class="mt-2 space-y-4 border-gray-200 pl-4 dark:border-gray-700">
						{entries.slice(1).map((entry) => (
							<NowEntry entry={entry} />
						))}
					</div>
				</details>
			)
		}
	</div>
</div>
